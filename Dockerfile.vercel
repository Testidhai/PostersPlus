
FROM ghcr.io/umbraprojects/postersplus:dev

RUN rm -rf /app/cache && \
    mkdir -p /tmp/postersplus-cache/tmdb_posters /tmp/postersplus-cache/tmdb_logos && \
    chown -R appuser:appuser /tmp/postersplus-cache && \
    ln -s /tmp/postersplus-cache /app/cache && \
    sed -i 's/--port 8000/--port "${PORT:-80}"/' /app/entrypoint.sh && \
    grep -F -- '--port "${PORT:-80}"' /app/entrypoint.sh
